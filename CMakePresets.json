{
  "version": 5,
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_APP": "ON",
        "BUILD_TESTS": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_COVERAGE": "OFF"
      }
    },
    {
      "name": "debug-tests",
      "inherits": "debug",
      "cacheVariables": { "BUILD_TESTS": "ON" }
    },
    {
      "name": "config-only",
      "inherits": "debug",
      "cacheVariables": { "BUILD_APP": "OFF" }
    },
    {
      "name": "coverage",
      "inherits": "debug-tests",
      "cacheVariables": { "ENABLE_COVERAGE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-tests", "configurePreset": "debug-tests" },
    { "name": "config-only", "configurePreset": "config-only" },
    { "name": "coverage", "configurePreset": "coverage", "targets": ["coverage"] }
  ],
  "testPresets": [
    {
      "name": "debug-tests",
      "configurePreset": "debug-tests",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
